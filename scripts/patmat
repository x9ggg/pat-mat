#!/usr/bin/env bash
# patmat: messenger between coding agents on herdr. See `patmat help` for usage.
set -euo pipefail

SOURCE=patmat
DOING_TTL_MS=21600000 # doing expires after 6 hours so stale status does not linger in the sidebar
NAME_RE='^[a-z][a-z0-9_-]{0,31}$'

die() {
  printf 'patmat: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
patmat: messenger between coding agents on herdr

  patmat who [--json]                     roster: who is online, what they own, what they are doing
  patmat card [--short SHORT] [--name N] [--role TEXT] [--doing TEXT]
                                          post or update your own card (--doing "" clears it).
                                          SHORT is for the user and leads the sidebar row; name N is the address between agents
  patmat ask <target> [-s SUBJECT]        ask a question or request work; body on stdin; prints this ask's id
  patmat reply <target> --re <id>         reply to an ask; body on stdin
  patmat tell <target>                    one-way notice; body on stdin
  patmat spawn <kind> [--short SHORT] [--name N] [--cwd DIR] [--role TEXT] [-- CLI args...]
                                          start another CLI as a sub-agent in a new tab, labelled with its short name
  patmat dismiss <name> [--force]         close a sub-agent you started
  patmat install                          install into every supported CLI on this machine (Claude Code, Codex, Grok, Antigravity); safe to rerun
  patmat pointer                          print the card pointer, for adding by hand to other CLIs' global instruction files
  patmat doctor                           check that the install on this machine is complete

<target> is a name from the roster or a pane id (e.g. db, w3:p1); name@pane also works.
Pass the body as a quoted heredoc; it is delivered verbatim:

  patmat ask db -s "clear test table" <<'EOF_BODY'
  Please clear the orders_test table in the staging database.
  EOF_BODY
EOF
}

# Call herdr; on success the result is in HOUT, on failure the error is in HERR_CODE / HERR_MSG.
herdr_call() {
  local errf
  errf=$(mktemp -t patmat.XXXXXX)
  HOUT="" HERR_CODE="" HERR_MSG=""
  if HOUT=$(herdr "$@" 2>"$errf"); then
    rm -f "$errf"
    return 0
  fi
  HERR_CODE=$(jq -r '.error.code // empty' "$errf" 2>/dev/null || true)
  HERR_MSG=$(jq -r '.error.message // empty' "$errf" 2>/dev/null || true)
  [ -n "$HERR_MSG" ] || HERR_MSG=$(cat "$errf")
  rm -f "$errf"
  # A sandbox blocking the socket makes every call fail; say so plainly so the agent reruns outside it.
  # cmd_doctor sets PATMAT_SOFT_SOCKET=1 to report this as one checkup item instead.
  case "$HERR_MSG" in
    *"Operation not permitted"*)
      [ "${PATMAT_SOFT_SOCKET:-0}" = 1 ] ||
        die "cannot reach the herdr socket (Operation not permitted): this command is running inside a sandbox that blocks local sockets. Rerun the same patmat command outside the sandbox."
      ;;
  esac
  return 1
}

need_herdr() {
  command -v herdr >/dev/null 2>&1 || die "herdr not found. Install it from https://herdr.dev"
  command -v jq >/dev/null 2>&1 || die "jq not found"
  if [ "${HERDR_ENV:-}" != 1 ] || [ -z "${HERDR_PANE_ID:-}" ]; then
    die "Not inside a herdr pane (HERDR_ENV≠1). Start this agent inside herdr, then try again."
  fi
}

tilde() {
  case "$1" in
    "$HOME") printf '~' ;;
    "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# Squash arbitrary text into a valid agent name; prints nothing if that is impossible.
slug() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_-]+/-/g; s/^[^a-z]+//; s/-+$//' | cut -c1-28
}

# Codex sessions share one background process for running commands, and commands inherit the first
# session's HERDR_PANE_ID, so inside Codex we find our own pane by CODEX_THREAD_ID and, when claiming it,
# record the thread id in that pane's sid token. Basis for a claim: the session calling patmat must be
# working right now. Someone else's claim is still valid if the live name on that pane equals the name
# token recorded at claim time (herdr clears the name when the agent exits). On success the result is in CODEX_PANE.
find_codex_pane() {
  local try
  CODEX_PANE=""
  for try in 1 2 3 4 5 6; do
    herdr_call agent list || return 1
    CODEX_PANE=$(jq -r --arg sid "$CODEX_THREAD_ID" '
      [.result.agents[] | select(.agent == "codex")] as $codex
      | ($codex | map(select(.tokens.sid == $sid))) as $mine
      | ($codex | map(select(.agent_status == "working"))) as $busy
      | ($busy | map(select((.tokens.sid // "") == "" or .name == null or .name != (.tokens.name // "")))) as $free
      | if ($mine | length) > 0 then $mine[0].pane_id
        elif ($free | length) == 1 then $free[0].pane_id
        elif ($busy | length) == 1 then $busy[0].pane_id
        else empty end
    ' <<<"$HOUT")
    [ -n "$CODEX_PANE" ] && return 0
    sleep 0.5
  done
  return 1
}

# Name ourselves when still unnamed: the project directory name, or the CLI kind in the home directory; add a number on a clash.
auto_name() {
  local base try n
  base=$(slug "$(basename "${SELF_CWD:-$PWD}")")
  if [ -z "$base" ] || [ "${SELF_CWD:-$PWD}" = "$HOME" ]; then base=$SELF_KIND; fi
  for n in "" 2 3 4 5 6 7 8 9; do
    try=$base${n:+-$n}
    if herdr_call agent rename "$SELF_PANE" "$try"; then
      SELF_NAME=$try
      return 0
    fi
  done
  return 1
}

# load_self [soft]: identify the caller. With soft, carry on even if unidentified (SELF_PANE empty); for read-only commands.
load_self() {
  local pane=$HERDR_PANE_ID sid="" tname=""
  if [ -n "${CODEX_THREAD_ID:-}" ]; then
    if find_codex_pane; then
      pane=$CODEX_PANE
    elif [ "${1:-}" = soft ]; then
      pane=""
    else
      die "Cannot tell which pane this Codex session is in: several Codex sessions are working at once, and the background process they share carries only one of their HERDR_PANE_IDs. Retry in a few seconds."
    fi
  fi
  if [ -n "$pane" ] && herdr_call agent get "$pane"; then
    SELF_NAME=$(jq -r '.result.agent.name // empty' <<<"$HOUT")
    SELF_KIND=$(jq -r '.result.agent.agent // "agent"' <<<"$HOUT")
    SELF_PANE=$(jq -r '.result.agent.pane_id' <<<"$HOUT")
    SELF_CWD=$(jq -r '.result.agent.cwd // empty' <<<"$HOUT")
    sid=$(jq -r '.result.agent.tokens.sid // empty' <<<"$HOUT")
    tname=$(jq -r '.result.agent.tokens.name // empty' <<<"$HOUT")
    SELF_IS_AGENT=1
  else
    SELF_NAME="" SELF_KIND=shell SELF_PANE=$pane SELF_CWD=$PWD SELF_IS_AGENT=0
  fi
  if [ "$SELF_IS_AGENT" = 1 ] && [ -n "${CODEX_THREAD_ID:-}" ]; then
    [ -n "$SELF_NAME" ] || auto_name || die "Automatic naming failed; set a name with patmat card --name."
    if [ "$sid" != "$CODEX_THREAD_ID" ] || [ "$tname" != "$SELF_NAME" ]; then
      herdr_call pane report-metadata "$SELF_PANE" --source "$SOURCE" --token "sid=$CODEX_THREAD_ID" --token "name=$SELF_NAME" || die "Failed to claim pane ${SELF_PANE}: ${HERR_MSG}"
    fi
  fi
  SELF_ADDR=${SELF_NAME:-$SELF_PANE}
  SELF_DESC="$SELF_KIND · $(tilde "${SELF_CWD:-$PWD}") · $SELF_PANE"
  if [ -n "$SELF_NAME" ]; then SELF_REPLY_TO="$SELF_NAME@$SELF_PANE"; else SELF_REPLY_TO=$SELF_PANE; fi
}

# Resolve <target>; the result is in TGT / TGT_JSON.
# For name@pane the pane wins (pane ids are never reused): it is the same agent if the agent there still has
# this name, or has restarted and is not yet named. Only when the pane no longer exists (moved or closed) fall back to the name.
resolve() {
  local to=$1 first=${1%%@*} pane="" cur
  case "$to" in *@*) pane=${to#*@} ;; esac
  if [ -n "$pane" ] && herdr_call agent get "$pane"; then
    cur=$(jq -r '.result.agent.name // empty' <<<"$HOUT")
    if [ -z "$cur" ] || [ "$cur" = "$first" ]; then
      TGT=$pane TGT_JSON=$HOUT
      return 0
    fi
    die "Pane ${pane} is now ${cur}, not ${first}; the message was not delivered. Run patmat who to check."
  fi
  if herdr_call agent get "$first"; then
    TGT=$first TGT_JSON=$HOUT
    return 0
  fi
  die "${to} is not on the roster. Run patmat who to see who is online."
}

new_id() {
  printf '%s-%06x' "$(printf '%s' "$SELF_ADDR" | tr -d ':')" $((((RANDOM << 9) ^ RANDOM) & 0xFFFFFF))
}

read_body() {
  [ -t 0 ] && die "The body goes on stdin: patmat $1 ... <<'EOF', then the body on the following lines, ending with EOF"
  BODY=$(cat)
  [ -n "${BODY//[[:space:]]/}" ] || die "The body is empty"
}

# deliver <target> <full text> <id>: deliver and confirm the recipient has started on it.
# herdr's "written" does not mean the recipient took it (a freshly started CLI swallows input), so wait
# until it turns working, or its state sequence number advances.
deliver() {
  local before after tries=0
  before=$(jq -r '.result.agent.state_change_seq // empty' <<<"$TGT_JSON")
  while :; do
    if herdr_call agent prompt "$1" "$2" --wait --until working --until blocked --timeout 30000; then return 0; fi
    case "$HERR_CODE" in
      agent_blocked)
        die "$1 is stopped at a confirmation or question prompt (blocked); the message was not delivered. Ask the user to handle that pane, then resend."
        ;;
      agent_prompt_stalled | timeout)
        if herdr_call agent get "$1"; then
          after=$(jq -r '.result.agent.state_change_seq // empty' <<<"$HOUT")
          [ "$after" = "$before" ] || return 0
        fi
        if herdr_call agent read "$1" --source visible && grep -qF "$3" <<<"$HOUT"; then
          die "The message is on $1's screen, but it has not started on it. Check with herdr agent read $1 --source visible before deciding whether to resend."
        fi
        tries=$((tries + 1))
        if [ "$tries" -ge 2 ]; then
          die "$1 did not take the message (no response after one retry); it may still be starting or stopped at some prompt. Check with herdr agent read $1 --source visible."
        fi
        ;;
      *)
        die "Delivery to $1 failed: ${HERR_MSG:-unknown error}"
        ;;
    esac
  done
}

target_brief() {
  jq -r '.result.agent | "\(.name // .pane_id) (\(.agent), \(.agent_status))"' <<<"$TGT_JSON"
}

cmd_who() {
  need_herdr
  load_self soft
  herdr_call agent list || die "Failed to read the roster: ${HERR_MSG}"
  if [ "${1:-}" = --json ]; then
    jq '.result.agents' <<<"$HOUT"
    return
  fi
  jq -r --arg me "$SELF_PANE" --arg home "$HOME" '
    .result.agents as $all
    | ($all | map({key: .pane_id, value: (.name // .pane_id)}) | from_entries) as $names
    | $all[]
    | (.cwd // "") as $cwd
    | [
        ((.name // .pane_id) + (if .tokens.short then " \"" + .tokens.short + "\"" else "" end) + (if .pane_id == $me then " (me)" else "" end)),
        .agent,
        .agent_status,
        (if $cwd == $home then "~" elif ($cwd | startswith($home + "/")) then "~" + $cwd[($home | length):] else $cwd end),
        ("role: " + (.tokens.role // "(none)")),
        ("doing: " + (.tokens.doing // .terminal_title_stripped // "(none)")),
        (if .tokens.parent then "sub-agent of " + ($names[.tokens.parent] // .tokens.parent) else "" end)
      ]
    | map(select(. != "")) | join("  |  ")
  ' <<<"$HOUT"
}

cmd_card() {
  need_herdr
  local name="" short="" role="" doing="" has_short=0 has_role=0 has_doing=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name=${2:?--name needs a value}; shift 2 ;;
      --short) short=${2?--short needs a value}; has_short=1; shift 2 ;;
      --role) role=${2?--role needs a value}; has_role=1; shift 2 ;;
      --doing) doing=${2?--doing needs a value}; has_doing=1; shift 2 ;;
      *) die "card: unknown argument $1" ;;
    esac
  done
  load_self
  [ "$SELF_IS_AGENT" = 1 ] || die "herdr does not see an agent in this pane, so no card can be posted."

  if [ -n "$name" ]; then
    [[ "$name" =~ $NAME_RE ]] || die 'The name must match [a-z][a-z0-9_-]{0,31}: '"${name}"
    if [ "$name" != "$SELF_NAME" ]; then
      herdr_call agent rename "$SELF_PANE" "$name" || die "Failed to rename to ${name}: ${HERR_MSG}"
      SELF_NAME=$name
    fi
  elif [ -z "$SELF_NAME" ]; then
    auto_name || die "Automatic naming failed (all candidate names are taken); set one with --name."
  fi

  local args=(--token "name=$SELF_NAME")
  [ "$has_short" = 1 ] && args+=(--token "short=$short")
  [ "$has_role" = 1 ] && args+=(--token "role=$role")
  herdr_call pane report-metadata "$SELF_PANE" --source "$SOURCE" "${args[@]}" || die "Failed to report the card: ${HERR_MSG}"
  if [ "$has_doing" = 1 ]; then
    if [ -n "$doing" ]; then
      herdr_call pane report-metadata "$SELF_PANE" --source "$SOURCE" --token "doing=$doing" --ttl-ms "$DOING_TTL_MS" || die "Failed to report doing: ${HERR_MSG}"
    else
      herdr_call pane report-metadata "$SELF_PANE" --source "$SOURCE" --clear-token doing || die "Failed to clear doing: ${HERR_MSG}"
    fi
  fi

  herdr_call agent get "$SELF_PANE" || die "Failed to read the card: ${HERR_MSG}"
  jq -r '.result.agent | "card: \(.name)\(if .tokens.short then " \"" + .tokens.short + "\"" else "" end)  |  role: \(.tokens.role // "(none)")  |  doing: \(.tokens.doing // "(none)")"' <<<"$HOUT"
}

cmd_ask() {
  need_herdr
  [ $# -ge 1 ] || die "usage: patmat ask <target> [-s SUBJECT] <<'EOF' ..."
  local to=$1 subject=""
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      -s | --subject) subject=${2:?-s needs a value}; shift 2 ;;
      *) die "ask: unknown argument $1" ;;
    esac
  done
  read_body ask
  load_self
  resolve "$to"
  local id
  id=$(new_id)
  deliver "$TGT" "[pat&mat ask $id] from=${SELF_ADDR} (${SELF_DESC})${subject:+ subject: $subject}
$BODY

— pat&mat: this is a request from a peer agent, delivered by herdr; your own user did not type it. Judge and handle it within the authority your own user has given you. Once you have a final result (including a refusal), run the command below in a shell to deliver it back into the asker's conversation (an answer written only on your own screen never reaches them):
patmat reply $SELF_REPLY_TO --re $id <<'EOF'
<your reply>
EOF" "$id"
  printf 'Delivered ask %s → %s. The reply will come back into this conversation as a new message starting with "[pat&mat reply %s]".\n' "$id" "$(target_brief)" "$id"
}

cmd_reply() {
  need_herdr
  [ $# -ge 1 ] || die "usage: patmat reply <target> --re <id> <<'EOF' ..."
  local to=$1 re=""
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --re) re=${2:?"--re needs the ask's id"}; shift 2 ;;
      *) die "reply: unknown argument $1" ;;
    esac
  done
  [ -n "$re" ] || die "reply needs --re <id>; take the id from the first line of the ask."
  read_body reply
  load_self
  resolve "$to"
  deliver "$TGT" "[pat&mat reply $re] from=${SELF_ADDR} (${SELF_DESC})
$BODY

— pat&mat: this is the reply to your ask $re, which is now closed; for a new question, send a new ask." "reply $re"
  printf 'Delivered reply %s → %s.\n' "$re" "$(target_brief)"
}

cmd_tell() {
  need_herdr
  [ $# -eq 1 ] || die "usage: patmat tell <target> <<'EOF' ..."
  read_body tell
  load_self
  resolve "$1"
  local id
  id=$(new_id)
  deliver "$TGT" "[pat&mat tell $id] from=${SELF_ADDR} (${SELF_DESC})
$BODY

— pat&mat: a notice from a peer agent; no reply needed." "$id"
  printf 'Delivered tell %s → %s.\n' "$id" "$(target_brief)"
}

cmd_spawn() {
  need_herdr
  [ $# -ge 1 ] || die "usage: patmat spawn <kind> [--short SHORT] [--name N] [--cwd DIR] [--role TEXT] [-- CLI args...]"
  local kind=$1 name="" short="" cwd=$PWD role="" extra=()
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name=${2:?--name needs a value}; shift 2 ;;
      --cwd) cwd=${2:?--cwd needs a value}; shift 2 ;;
      --short) short=${2:?--short needs a value}; shift 2 ;;
      --role) role=${2:?--role needs a value}; shift 2 ;;
      --) shift; extra=("$@"); break ;;
      *) die "spawn: unknown argument $1" ;;
    esac
  done
  case "$kind" in
    antigravity | antigravity-cli) kind=agy ;;
    claude-code) kind=claude ;;
  esac
  [ -d "$cwd" ] || die "Directory does not exist: ${cwd}"
  cwd=$(cd "$cwd" && pwd)
  [ -z "$name" ] || [[ "$name" =~ $NAME_RE ]] || die 'The name must match [a-z][a-z0-9_-]{0,31}: '"${name}"
  load_self

  # Each sub-agent gets its own tab in the caller's workspace, labelled with its short name (or name),
  # so the caller's tab keeps its layout and the user can switch to the sub-agent from the tab bar.
  local ws base tab pane
  herdr_call pane get "$SELF_PANE" || die "Failed to look up your pane: ${HERR_MSG}"
  ws=$(jq -r '.result.pane.workspace_id' <<<"$HOUT")
  base=${name:-$(slug "$SELF_ADDR-$kind")}
  herdr_call tab create --workspace "$ws" --cwd "$cwd" --label "${short:-$base}" --no-focus || die "Failed to create a new tab: ${HERR_MSG}"
  tab=$(jq -r '.result.tab.tab_id' <<<"$HOUT")
  pane=$(jq -r '.result.root_pane.pane_id' <<<"$HOUT")

  local try n started="" ready=1
  for n in "" 2 3 4 5 6 7 8 9; do
    try=$base${n:+-$n}
    if herdr_call agent start "$try" --kind "$kind" --pane "$pane" ${extra[@]+-- "${extra[@]}"}; then
      started=$try
      break
    fi
    case "$HERR_CODE" in
      agent_not_ready) started=$try ready=0; break ;;
      agent_name_taken) [ -z "$name" ] || break ;;
      *) break ;;
    esac
  done
  if [ -z "$started" ]; then
    local why=$HERR_MSG
    herdr_call tab close "$tab" || true
    die "Failed to start ${kind}: ${why:-unknown error}"
  fi
  if [ -z "$short" ] && [ "$started" != "$base" ]; then herdr_call tab rename "$tab" "$started" || true; fi

  local args=(--token "name=$started" --token "parent=$SELF_PANE")
  [ -n "$short" ] && args+=(--token "short=$short")
  [ -n "$role" ] && args+=(--token "role=$role")
  herdr_call pane report-metadata "$pane" --source "$SOURCE" "${args[@]}" || true

  if [ "$ready" = 1 ]; then
    printf 'Started sub-agent %s (%s, new tab "%s", pane %s, cwd %s). Give it the task with patmat ask %s; after you accept its work, patmat dismiss %s.\n' \
      "$started" "$kind" "${short:-$started}" "$pane" "$(tilde "$cwd")" "$started" "$started"
  else
    printf 'Sub-agent %s (%s, new tab "%s", pane %s) started but is stopped at a confirmation prompt (e.g. whether to trust the directory). Ask the user to handle it in that tab, then patmat ask %s once it is ready.\n' \
      "$started" "$kind" "${short:-$started}" "$pane" "$started"
  fi
}

cmd_dismiss() {
  need_herdr
  [ $# -ge 1 ] || die "usage: patmat dismiss <name> [--force]"
  local force=0
  [ "${2:-}" = --force ] && force=1
  load_self
  resolve "$1"
  local parent pane status
  parent=$(jq -r '.result.agent.tokens.parent // empty' <<<"$TGT_JSON")
  pane=$(jq -r '.result.agent.pane_id' <<<"$TGT_JSON")
  status=$(jq -r '.result.agent.agent_status' <<<"$TGT_JSON")
  [ "$parent" = "$SELF_PANE" ] || die "$1 is not a sub-agent you started; only the agent that started it, or the user, can close it."
  if [ "$status" = working ] && [ "$force" = 0 ]; then
    die "$1 is still working. Wait for it to stop before dismissing, or add --force if you mean to abort it."
  fi
  # Close the whole tab when the sub-agent is alone in it (the tab spawn created); otherwise just its pane.
  local tab count
  tab=$(jq -r '.result.agent.tab_id' <<<"$TGT_JSON")
  count=0
  if herdr_call tab get "$tab"; then count=$(jq -r '.result.tab.pane_count // 0' <<<"$HOUT"); fi
  if [ "$count" = 1 ]; then
    herdr_call tab close "$tab" || die "Failed to close $1: ${HERR_MSG}"
    printf 'Closed sub-agent %s (tab %s).\n' "$1" "$tab"
  else
    herdr_call pane close "$pane" || die "Failed to close $1: ${HERR_MSG}"
    printf 'Closed sub-agent %s (pane %s).\n' "$1" "$pane"
  fi
}

# Supported CLIs, one per line: command|herdr integration id|global skill directory|global instruction file
known_clis() {
  printf '%s\n' \
    "claude|claude|$HOME/.claude/skills|$HOME/.claude/CLAUDE.md" \
    "codex|codex|$HOME/.agents/skills|$HOME/.codex/AGENTS.md" \
    "grok|grok|$HOME/.grok/skills|$HOME/.grok/AGENTS.md" \
    "agy|antigravity-cli|$HOME/.agents/skills|$HOME/.gemini/config/AGENTS.md"
}

# Card pointer: the section written into each CLI's global instruction file. It must contain the literal
# patmat card; install and doctor rely on it.
pointer_text() {
  cat <<'EOF'
## pat&mat

When working inside herdr (environment variable HERDR_ENV=1), on receiving a task first run `patmat card --short "<a short name that lets the user recognize this session at a glance, at most 12 columns wide: about 6 CJK characters or 12 Latin letters>" --role "<what you own>" --doing "<what you are doing>"` to post your card, and update --doing when you switch tasks. Write the short name, role, and doing in the user's language, putting the key point first: the sidebar shows only the first ~20 columns of role and doing. To collaborate with other agents, or when you receive a message starting with [pat&mat, use the pat-mat skill; if that skill is not available, run `patmat help`.
EOF
}

# Real path of this script (through symlinks).
script_path() {
  local src=$0 dir
  while [ -L "$src" ]; do
    dir=$(cd "$(dirname "$src")" && pwd -P)
    src=$(readlink "$src")
    case "$src" in /*) ;; *) src=$dir/$src ;; esac
  done
  printf '%s/%s' "$(cd "$(dirname "$src")" && pwd -P)" "$(basename "$src")"
}

# ensure_link <target> <link path>: skip if already correct; leave the path alone if something else occupies it.
ensure_link() {
  local target=$1 path=$2 cur
  if [ -L "$path" ]; then
    cur=$(readlink "$path")
    if [ "$cur" = "$target" ]; then
      printf '  ready      %s\n' "$path"
    else
      printf '  skipped    %s already points to %s; left unchanged\n' "$path" "$cur"
    fi
  elif [ -e "$path" ]; then
    printf '  skipped    %s exists and is not a symlink; left unchanged\n' "$path"
  else
    mkdir -p "$(dirname "$path")"
    ln -s "$target" "$path"
    printf '  linked     %s -> %s\n' "$path" "$target"
  fi
}

cmd_install() {
  command -v herdr >/dev/null 2>&1 || die "herdr not found; install it first: https://herdr.dev"
  command -v jq >/dev/null 2>&1 || die "jq not found; install it first (brew install jq)"
  local self root
  self=$(script_path)
  root=$(dirname "$(dirname "$self")")
  [ -f "$root/SKILL.md" ] || die "SKILL.md not found under ${root}; run this from a complete pat-mat repository."

  printf 'patmat command:\n'
  ensure_link "$self" "$HOME/.local/bin/patmat"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) printf '  note       ~/.local/bin is not on PATH; add it in your shell config\n' ;;
  esac

  local status bin id skills file line found=0
  status=$(herdr integration status 2>/dev/null || true)
  while IFS='|' read -r bin id skills file; do
    command -v "$bin" >/dev/null 2>&1 || continue
    found=1
    printf '%s:\n' "$bin"
    ensure_link "$root" "$skills/pat-mat"
    if [ -f "$file" ] && grep -q 'patmat card' "$file"; then
      printf '  ready      %s has the card pointer\n' "$file"
    else
      mkdir -p "$(dirname "$file")"
      {
        if [ -s "$file" ]; then printf '\n'; fi
        pointer_text
      } >>"$file"
      printf '  wrote      card pointer -> %s\n' "$file"
    fi
    line=$(printf '%s\n' "$status" | grep "^$id[ :(]" | head -1 || true)
    case "$line" in
      *": current"*) printf '  ready      herdr integration %s\n' "$id" ;;
      *)
        if herdr integration install "$id" </dev/null >/dev/null 2>&1; then
          printf '  installed  herdr integration %s\n' "$id"
        else
          printf '  todo       herdr integration %s; run herdr integration install %s by hand\n' "$id" "$id"
        fi
        ;;
    esac
    # Antigravity runs commands in a terminal sandbox that blocks the herdr socket. A command(patmat)
    # allow rule lets the agent rerun patmat outside the sandbox without an approval prompt.
    if [ "$bin" = agy ]; then
      local agyset=$HOME/.gemini/antigravity-cli/settings.json tmp
      if [ -f "$agyset" ] && grep -qF '"command(patmat)"' "$agyset"; then
        printf '  ready      %s allows patmat\n' "$agyset"
      else
        mkdir -p "$(dirname "$agyset")"
        [ -s "$agyset" ] || printf '{}\n' >"$agyset"
        tmp=$(mktemp "$agyset.XXXXXX")
        if jq '.permissions.allow = ((.permissions.allow // []) + ["command(patmat)"] | unique)' "$agyset" >"$tmp" 2>/dev/null; then
          chmod 600 "$tmp"
          mv "$tmp" "$agyset"
          printf '  wrote      command(patmat) allow rule -> %s\n' "$agyset"
        else
          rm -f "$tmp"
          printf '  todo       %s is not valid JSON; add "command(patmat)" to permissions.allow by hand\n' "$agyset"
        fi
      fi
    fi
  done <<EOF
$(known_clis)
EOF
  [ "$found" = 1 ] || printf 'No supported CLI found (claude, codex, grok, agy). Install one of them, then rerun patmat install.\n'

  printf 'herdr sidebar:\n'
  local cfg=${HERDR_CONFIG_PATH:-$HOME/.config/herdr/config.toml}
  if [ -f "$cfg" ] && grep -q '\$short' "$cfg" && grep -q '\$role' "$cfg" && grep -q '\$doing' "$cfg"; then
    printf '  ready      %s\n' "$cfg"
  elif [ -f "$cfg" ] && grep -q '^\[ui\.sidebar\.agents\]' "$cfg"; then
    printf '  todo       %s already has a custom [ui.sidebar.agents]; add %s to its rows by hand\n' "$cfg" "\$short, \$role, \$doing"
  else
    mkdir -p "$(dirname "$cfg")"
    {
      if [ -s "$cfg" ]; then printf '\n'; fi
      cat <<'EOF'
[ui.sidebar.agents]
rows = [
  ["state_icon", { token = "$short", bold = true }, { token = "workspace", bold = false }, "machine"],
  ["agent", "$role"],
  ["$doing"],
]
EOF
    } >>"$cfg"
    printf '  wrote      card rows -> %s\n' "$cfg"
    herdr server reload-config >/dev/null 2>&1 || printf '  note       herdr is not running; the sidebar config takes effect on its next start\n'
  fi

  printf '\nDone. Start or restart an agent inside herdr and it will post its card on its own; run patmat doctor inside an agent at any time for a checkup.\n'
  printf 'If Codex uses the workspace-write sandbox, it also needs access to the herdr socket; see %s/SETUP.md.\n' "$root"
}

cmd_doctor() {
  local bad=0 PATMAT_SOFT_SOCKET=1
  ok() { printf '  ok  %s\n' "$*"; }
  miss() {
    printf '  !!  %s\n' "$*"
    bad=1
  }
  note() { printf '  --  %s\n' "$*"; }

  if command -v herdr >/dev/null 2>&1; then ok "herdr: $(herdr --version 2>/dev/null)"; else miss "herdr is not installed (https://herdr.dev)"; fi
  if command -v jq >/dev/null 2>&1; then ok "jq"; else miss "jq is not installed"; fi

  local self onpath
  self=$(script_path)
  onpath=$(command -v patmat 2>/dev/null || true)
  if [ -n "$onpath" ]; then ok "patmat is on PATH: ${onpath}"; else miss "patmat is not on PATH: run \"$self\" install"; fi

  if [ "${HERDR_ENV:-}" = 1 ]; then
    ok "running inside herdr"
    if command -v herdr >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
      if herdr_call agent list; then
        ok "herdr socket reachable, $(jq '.result.agents | length' <<<"$HOUT") agents online"
        load_self soft
        if [ -z "$SELF_PANE" ]; then
          miss "cannot tell which pane this Codex session is in (several Codex sessions are working at once); rerun in a few seconds"
        elif [ "$SELF_PANE" != "${HERDR_PANE_ID:-}" ]; then
          ok "this session is ${SELF_ADDR}, in pane ${SELF_PANE} (identified by Codex thread id; the inherited HERDR_PANE_ID=${HERDR_PANE_ID:-} belongs to another Codex session)"
        else
          ok "this session is ${SELF_ADDR}, in pane $SELF_PANE"
        fi
      else
        miss "herdr socket unreachable: ${HERR_MSG}. Operation not permitted means this CLI's sandbox is blocking the socket; see the sandbox section of SETUP.md"
      fi
    fi
  else
    miss "not inside a herdr pane: run herdr first, then start the agent inside it"
  fi

  local cfg=${HERDR_CONFIG_PATH:-$HOME/.config/herdr/config.toml}
  if [ -f "$cfg" ] && grep -q '\$short' "$cfg" && grep -q '\$role' "$cfg" && grep -q '\$doing' "$cfg"; then
    ok "sidebar is configured to show \$short / \$role / \$doing (${cfg})"
  else
    miss "sidebar does not show cards yet: add \$short, \$role, \$doing to the [ui.sidebar.agents] rows in $cfg"
  fi

  if command -v herdr >/dev/null 2>&1; then
    local status bin id line
    status=$(herdr integration status 2>/dev/null || true)
    for bin in claude codex kimi grok agy; do
      command -v "$bin" >/dev/null 2>&1 || continue
      id=$bin
      [ "$bin" = agy ] && id=antigravity-cli
      line=$(printf '%s\n' "$status" | grep "^$id[ :(]" | head -1 || true)
      case "$line" in
        *": current"*) ok "herdr integration $id" ;;
        *) miss "herdr integration $id is not ready: herdr integration install $id" ;;
      esac
    done
  fi

  # Each supported CLI: the skill is readable and the global instructions have the card pointer.
  local bin id skills file
  while IFS='|' read -r bin id skills file; do
    command -v "$bin" >/dev/null 2>&1 || continue
    if [ -r "$skills/pat-mat/SKILL.md" ]; then ok "$bin can read the skill ($skills/pat-mat)"; else miss "$bin cannot read the skill: run patmat install"; fi
    if [ -f "$file" ] && grep -q 'patmat card' "$file"; then ok "$bin's global instructions have the card pointer (${file})"; else miss "$bin's global instructions lack the card pointer: run patmat install"; fi
    if [ "$bin" = agy ]; then
      if grep -qF '"command(patmat)"' "$HOME/.gemini/antigravity-cli/settings.json" 2>/dev/null; then ok "agy allows patmat outside its sandbox"; else miss "agy lacks the command(patmat) allow rule: run patmat install"; fi
    fi
  done <<EOF
$(known_clis)
EOF
  command -v kimi >/dev/null 2>&1 && note "kimi: check its docs for where its skill directory and global instruction file live, and confirm both are in place"

  if [ "$bad" = 0 ]; then
    printf 'All set.\n'
  else
    printf 'Some items are missing; fix each one following SETUP.md, then rerun patmat doctor.\n'
    return 1
  fi
}

main() {
  local cmd=${1:-help}
  [ $# -gt 0 ] && shift
  case "$cmd" in
    who) cmd_who "$@" ;;
    card) cmd_card "$@" ;;
    ask) cmd_ask "$@" ;;
    reply) cmd_reply "$@" ;;
    tell) cmd_tell "$@" ;;
    spawn) cmd_spawn "$@" ;;
    dismiss) cmd_dismiss "$@" ;;
    install) cmd_install "$@" ;;
    pointer) pointer_text ;;
    doctor) cmd_doctor "$@" ;;
    help | -h | --help) usage ;;
    *) die "Unknown subcommand ${cmd}. Run patmat help for usage." ;;
  esac
}

main "$@"
