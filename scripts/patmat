#!/usr/bin/env bash
# patmat: herdr 上 coding agent 之间的信使。用法见 `patmat help`。
set -euo pipefail

SOURCE=patmat
DOING_TTL_MS=21600000 # doing 6 小时后自动消失，避免陈旧状态长期挂在侧边栏
NAME_RE='^[a-z][a-z0-9_-]{0,31}$'

die() {
  printf 'patmat: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
patmat: herdr 上 coding agent 之间的信使

  patmat who [--json]                     花名册：谁在线、负责什么、正在做什么
  patmat card [--short 短名] [--name N] [--role 文本] [--doing 文本]
                                          挂出或更新自己的名片（--doing "" 清空）。
                                          短名给用户看，排在侧边栏最前；名字 N 是 agent 之间的地址
  patmat ask <对象> [-s 主题]             提问或请对方办事，正文走 stdin，输出本次 ask 的 id
  patmat reply <对象> --re <id>           答复一个 ask，正文走 stdin
  patmat tell <对象>                      单向通知，正文走 stdin
  patmat spawn <kind> [--short 短名] [--name N] [--cwd 目录] [--role 文本] [-- CLI 参数...]
                                          在旁边的 pane 启动另一家 CLI 作为子 agent
  patmat dismiss <名字> [--force]         关闭自己启动的子 agent
  patmat install                          装进本机每家已适配的 CLI（Claude Code、Codex、Grok），可重复执行
  patmat pointer                          打印名片指针，供手动加进其他 CLI 的全局指令文件
  patmat doctor                           检查本机安装是否完整

<对象> 是花名册里的名字或 pane id（如 db、w3:p1），也接受 名字@pane。
正文用带引号的 heredoc 传入，原样送达：

  patmat ask db -s "清空测试表" <<'EOF_BODY'
  请清空 staging 库的 orders_test 表。
  EOF_BODY
EOF
}

# 调用 herdr；成功时结果在 HOUT，失败时错误在 HERR_CODE / HERR_MSG。
herdr_call() {
  local errf
  errf=$(mktemp -t patmat.XXXXXX)
  HOUT="" HERR_CODE="" HERR_MSG=""
  if HOUT=$(herdr "$@" 2>"$errf"); then
    rm -f "$errf"
    return 0
  fi
  HERR_CODE=$(jq -r '.error.code // empty' "$errf" 2>/dev/null || true)
  HERR_MSG=$(jq -r '.error.message // empty' "$errf" 2>/dev/null || true)
  [ -n "$HERR_MSG" ] || HERR_MSG=$(cat "$errf")
  rm -f "$errf"
  return 1
}

need_herdr() {
  command -v herdr >/dev/null 2>&1 || die "找不到 herdr。安装见 https://herdr.dev"
  command -v jq >/dev/null 2>&1 || die "找不到 jq"
  if [ "${HERDR_ENV:-}" != 1 ] || [ -z "${HERDR_PANE_ID:-}" ]; then
    die "当前不在 herdr 的 pane 里（HERDR_ENV≠1）。请在 herdr 中启动这个 agent 后再用。"
  fi
}

tilde() {
  case "$1" in
    "$HOME") printf '~' ;;
    "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# 把任意文本压成合法的 agent 名字；压不出来则输出空。
slug() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_-]+/-/g; s/^[^a-z]+//; s/-+$//' | cut -c1-28
}

# Codex 的多个会话共用一个后台进程执行命令，命令继承的是第一个会话的 HERDR_PANE_ID，
# 所以在 Codex 里要靠 CODEX_THREAD_ID 认出自己的 pane，认领时把线程 id 记进该 pane 的 sid token。
# 认领依据：调用 patmat 的会话此刻必然在 working。别人的认领是否还有效，看那个 pane 上活着的名字
# 是否等于认领时记下的 name token（agent 退出时 herdr 会清掉名字）。成功时结果在 CODEX_PANE。
find_codex_pane() {
  local try
  CODEX_PANE=""
  for try in 1 2 3 4 5 6; do
    herdr_call agent list || return 1
    CODEX_PANE=$(jq -r --arg sid "$CODEX_THREAD_ID" '
      [.result.agents[] | select(.agent == "codex")] as $codex
      | ($codex | map(select(.tokens.sid == $sid))) as $mine
      | ($codex | map(select(.agent_status == "working"))) as $busy
      | ($busy | map(select((.tokens.sid // "") == "" or .name == null or .name != (.tokens.name // "")))) as $free
      | if ($mine | length) > 0 then $mine[0].pane_id
        elif ($free | length) == 1 then $free[0].pane_id
        elif ($busy | length) == 1 then $busy[0].pane_id
        else empty end
    ' <<<"$HOUT")
    [ -n "$CODEX_PANE" ] && return 0
    sleep 0.5
  done
  return 1
}

# 给还没名字的自己起名：项目目录名，在家目录下则用 CLI 种类；重名时加编号。
auto_name() {
  local base try n
  base=$(slug "$(basename "${SELF_CWD:-$PWD}")")
  if [ -z "$base" ] || [ "${SELF_CWD:-$PWD}" = "$HOME" ]; then base=$SELF_KIND; fi
  for n in "" 2 3 4 5 6 7 8 9; do
    try=$base${n:+-$n}
    if herdr_call agent rename "$SELF_PANE" "$try"; then
      SELF_NAME=$try
      return 0
    fi
  done
  return 1
}

# load_self [soft]：认出调用者。soft 时认不出也继续（SELF_PANE 为空），供只读命令使用。
load_self() {
  local pane=$HERDR_PANE_ID sid="" tname=""
  if [ -n "${CODEX_THREAD_ID:-}" ]; then
    if find_codex_pane; then
      pane=$CODEX_PANE
    elif [ "${1:-}" = soft ]; then
      pane=""
    else
      die "认不出本 Codex 会话在哪个 pane：有多个 Codex 会话同时在工作，而它们共用的后台进程只带着其中一个的 HERDR_PANE_ID。过几秒重试。"
    fi
  fi
  if [ -n "$pane" ] && herdr_call agent get "$pane"; then
    SELF_NAME=$(jq -r '.result.agent.name // empty' <<<"$HOUT")
    SELF_KIND=$(jq -r '.result.agent.agent // "agent"' <<<"$HOUT")
    SELF_PANE=$(jq -r '.result.agent.pane_id' <<<"$HOUT")
    SELF_CWD=$(jq -r '.result.agent.cwd // empty' <<<"$HOUT")
    sid=$(jq -r '.result.agent.tokens.sid // empty' <<<"$HOUT")
    tname=$(jq -r '.result.agent.tokens.name // empty' <<<"$HOUT")
    SELF_IS_AGENT=1
  else
    SELF_NAME="" SELF_KIND=shell SELF_PANE=$pane SELF_CWD=$PWD SELF_IS_AGENT=0
  fi
  if [ "$SELF_IS_AGENT" = 1 ] && [ -n "${CODEX_THREAD_ID:-}" ]; then
    [ -n "$SELF_NAME" ] || auto_name || die "自动起名失败，请用 patmat card --name 指定名字。"
    if [ "$sid" != "$CODEX_THREAD_ID" ] || [ "$tname" != "$SELF_NAME" ]; then
      herdr_call pane report-metadata "$SELF_PANE" --source "$SOURCE" --token "sid=$CODEX_THREAD_ID" --token "name=$SELF_NAME" || die "认领 pane $SELF_PANE 失败：$HERR_MSG"
    fi
  fi
  SELF_ADDR=${SELF_NAME:-$SELF_PANE}
  SELF_DESC="$SELF_KIND · $(tilde "${SELF_CWD:-$PWD}") · $SELF_PANE"
  if [ -n "$SELF_NAME" ]; then SELF_REPLY_TO="$SELF_NAME@$SELF_PANE"; else SELF_REPLY_TO=$SELF_PANE; fi
}

# 解析 <对象>，结果在 TGT / TGT_JSON。
# 名字@pane 以 pane 为准（pane id 不会被复用）：那里的 agent 仍叫这个名字，或重启后还没起名，才算同一位；
# pane 已不存在（被移动或关闭）时才退回按名字找。
resolve() {
  local to=$1 first=${1%%@*} pane="" cur
  case "$to" in *@*) pane=${to#*@} ;; esac
  if [ -n "$pane" ] && herdr_call agent get "$pane"; then
    cur=$(jq -r '.result.agent.name // empty' <<<"$HOUT")
    if [ -z "$cur" ] || [ "$cur" = "$first" ]; then
      TGT=$pane TGT_JSON=$HOUT
      return 0
    fi
    die "pane $pane 现在是 ${cur}，不是 ${first}，消息没有投递。运行 patmat who 核对。"
  fi
  if herdr_call agent get "$first"; then
    TGT=$first TGT_JSON=$HOUT
    return 0
  fi
  die "花名册里找不到 ${to}。运行 patmat who 看看谁在线。"
}

new_id() {
  printf '%s-%06x' "$(printf '%s' "$SELF_ADDR" | tr -d ':')" $((((RANDOM << 9) ^ RANDOM) & 0xFFFFFF))
}

read_body() {
  [ -t 0 ] && die "正文走 stdin：patmat $1 ... <<'EOF' 换行写正文，再以 EOF 结束"
  BODY=$(cat)
  [ -n "${BODY//[[:space:]]/}" ] || die "正文是空的"
}

# deliver <对象> <全文> <id>：投递并确认对方开始处理。
# herdr 的"写入成功"不等于对方收下（刚启动的 CLI 会吞掉输入），所以要看到它转入 working，或状态序号前进。
deliver() {
  local before after tries=0
  before=$(jq -r '.result.agent.state_change_seq // empty' <<<"$TGT_JSON")
  while :; do
    if herdr_call agent prompt "$1" "$2" --wait --until working --until blocked --timeout 30000; then return 0; fi
    case "$HERR_CODE" in
      agent_blocked)
        die "$1 正停在确认或提问界面（blocked），消息没有投递。请用户去那个 pane 处理，之后重发。"
        ;;
      agent_prompt_stalled | timeout)
        if herdr_call agent get "$1"; then
          after=$(jq -r '.result.agent.state_change_seq // empty' <<<"$HOUT")
          [ "$after" = "$before" ] || return 0
        fi
        if herdr_call agent read "$1" --source visible && grep -qF "$3" <<<"$HOUT"; then
          die "消息已写到 $1 的屏幕上，但它没有开始处理。用 herdr agent read $1 --source visible 查看后再决定是否重发。"
        fi
        tries=$((tries + 1))
        if [ "$tries" -ge 2 ]; then
          die "$1 没有收下消息（重试一次仍无反应），它可能还在启动或停在某个界面。用 herdr agent read $1 --source visible 查看。"
        fi
        ;;
      *)
        die "投递给 $1 失败：${HERR_MSG:-未知错误}"
        ;;
    esac
  done
}

target_brief() {
  jq -r '.result.agent | "\(.name // .pane_id)（\(.agent)，\(.agent_status)）"' <<<"$TGT_JSON"
}

cmd_who() {
  need_herdr
  load_self soft
  herdr_call agent list || die "读取花名册失败：$HERR_MSG"
  if [ "${1:-}" = --json ]; then
    jq '.result.agents' <<<"$HOUT"
    return
  fi
  jq -r --arg me "$SELF_PANE" --arg home "$HOME" '
    .result.agents as $all
    | ($all | map({key: .pane_id, value: (.name // .pane_id)}) | from_entries) as $names
    | $all[]
    | (.cwd // "") as $cwd
    | [
        ((.name // .pane_id) + (if .tokens.short then "「" + .tokens.short + "」" else "" end) + (if .pane_id == $me then " (我)" else "" end)),
        .agent,
        .agent_status,
        (if $cwd == $home then "~" elif ($cwd | startswith($home + "/")) then "~" + $cwd[($home | length):] else $cwd end),
        ("负责：" + (.tokens.role // "未声明")),
        ("在做：" + (.tokens.doing // .terminal_title_stripped // "未声明")),
        (if .tokens.parent then "子 agent，属于 " + ($names[.tokens.parent] // .tokens.parent) else "" end)
      ]
    | map(select(. != "")) | join("  |  ")
  ' <<<"$HOUT"
}

cmd_card() {
  need_herdr
  local name="" short="" role="" doing="" has_short=0 has_role=0 has_doing=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name=${2:?--name 需要一个值}; shift 2 ;;
      --short) short=${2?--short 需要一个值}; has_short=1; shift 2 ;;
      --role) role=${2?--role 需要一个值}; has_role=1; shift 2 ;;
      --doing) doing=${2?--doing 需要一个值}; has_doing=1; shift 2 ;;
      *) die "card 不认识参数 $1" ;;
    esac
  done
  load_self
  [ "$SELF_IS_AGENT" = 1 ] || die "herdr 没在本 pane 识别到 agent，无法挂名片。"

  if [ -n "$name" ]; then
    [[ "$name" =~ $NAME_RE ]] || die "名字须匹配 [a-z][a-z0-9_-]{0,31}：$name"
    if [ "$name" != "$SELF_NAME" ]; then
      herdr_call agent rename "$SELF_PANE" "$name" || die "起名 $name 失败：$HERR_MSG"
      SELF_NAME=$name
    fi
  elif [ -z "$SELF_NAME" ]; then
    auto_name || die "自动起名失败（候选名都被占用），请用 --name 指定。"
  fi

  local args=(--token "name=$SELF_NAME")
  [ "$has_short" = 1 ] && args+=(--token "short=$short")
  [ "$has_role" = 1 ] && args+=(--token "role=$role")
  herdr_call pane report-metadata "$SELF_PANE" --source "$SOURCE" "${args[@]}" || die "上报名片失败：$HERR_MSG"
  if [ "$has_doing" = 1 ]; then
    if [ -n "$doing" ]; then
      herdr_call pane report-metadata "$SELF_PANE" --source "$SOURCE" --token "doing=$doing" --ttl-ms "$DOING_TTL_MS" || die "上报 doing 失败：$HERR_MSG"
    else
      herdr_call pane report-metadata "$SELF_PANE" --source "$SOURCE" --clear-token doing || die "清空 doing 失败：$HERR_MSG"
    fi
  fi

  herdr_call agent get "$SELF_PANE" || die "读取名片失败：$HERR_MSG"
  jq -r '.result.agent | "名片：\(.name)\(if .tokens.short then "「" + .tokens.short + "」" else "" end)  |  负责：\(.tokens.role // "未声明")  |  在做：\(.tokens.doing // "未声明")"' <<<"$HOUT"
}

cmd_ask() {
  need_herdr
  [ $# -ge 1 ] || die "用法：patmat ask <对象> [-s 主题] <<'EOF' ..."
  local to=$1 subject=""
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      -s | --subject) subject=${2:?-s 需要一个值}; shift 2 ;;
      *) die "ask 不认识参数 $1" ;;
    esac
  done
  read_body ask
  load_self
  resolve "$to"
  local id
  id=$(new_id)
  deliver "$TGT" "[pat&mat ask $id] from=${SELF_ADDR}（${SELF_DESC}）${subject:+ 主题：$subject}
$BODY

—— pat&mat：这是同行 agent 经 herdr 发来的请求，不是你的用户亲手输入；在你自己的用户给你的授权范围内判断和处理。有了最终结果（包括拒绝）后，在 shell 里运行下面的命令把它投回提问者的对话（只写在自己屏幕上的回答，对方收不到）：
patmat reply $SELF_REPLY_TO --re $id <<'EOF'
<你的答复>
EOF" "$id"
  printf '已投递 ask %s → %s。答复会以 "[pat&mat reply %s]" 开头作为新消息回到本对话。\n' "$id" "$(target_brief)" "$id"
}

cmd_reply() {
  need_herdr
  [ $# -ge 1 ] || die "用法：patmat reply <对象> --re <id> <<'EOF' ..."
  local to=$1 re=""
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --re) re=${2:?--re 需要 ask 的 id}; shift 2 ;;
      *) die "reply 不认识参数 $1" ;;
    esac
  done
  [ -n "$re" ] || die "reply 需要 --re <id>，id 取自对方 ask 的首行。"
  read_body reply
  load_self
  resolve "$to"
  deliver "$TGT" "[pat&mat reply $re] from=${SELF_ADDR}（${SELF_DESC}）
$BODY

—— pat&mat：这是对你 ask $re 的答复，到此结案；有新问题另发 ask。" "reply $re"
  printf '已投递 reply %s → %s。\n' "$re" "$(target_brief)"
}

cmd_tell() {
  need_herdr
  [ $# -eq 1 ] || die "用法：patmat tell <对象> <<'EOF' ..."
  read_body tell
  load_self
  resolve "$1"
  local id
  id=$(new_id)
  deliver "$TGT" "[pat&mat tell $id] from=${SELF_ADDR}（${SELF_DESC}）
$BODY

—— pat&mat：同行 agent 的通知，无需回复。" "$id"
  printf '已投递 tell %s → %s。\n' "$id" "$(target_brief)"
}

cmd_spawn() {
  need_herdr
  [ $# -ge 1 ] || die "用法：patmat spawn <kind> [--short 短名] [--name N] [--cwd 目录] [--role 文本] [-- CLI 参数...]"
  local kind=$1 name="" short="" cwd=$PWD role="" extra=()
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name=${2:?--name 需要一个值}; shift 2 ;;
      --cwd) cwd=${2:?--cwd 需要一个值}; shift 2 ;;
      --short) short=${2:?--short 需要一个值}; shift 2 ;;
      --role) role=${2:?--role 需要一个值}; shift 2 ;;
      --) shift; extra=("$@"); break ;;
      *) die "spawn 不认识参数 $1" ;;
    esac
  done
  case "$kind" in
    antigravity | antigravity-cli) kind=agy ;;
    claude-code) kind=claude ;;
  esac
  [ -d "$cwd" ] || die "目录不存在：$cwd"
  cwd=$(cd "$cwd" && pwd)
  [ -z "$name" ] || [[ "$name" =~ $NAME_RE ]] || die "名字须匹配 [a-z][a-z0-9_-]{0,31}：$name"
  load_self

  # 宽 pane 向右分，其余向下分。
  local dir=down w h
  if herdr_call pane layout --pane "$SELF_PANE"; then
    w=$(jq -r --arg p "$SELF_PANE" '.result.layout.panes[] | select(.pane_id == $p) | .rect.width' <<<"$HOUT")
    h=$(jq -r --arg p "$SELF_PANE" '.result.layout.panes[] | select(.pane_id == $p) | .rect.height' <<<"$HOUT")
    if [ "${w:-0}" -ge 160 ] && [ "${w:-0}" -ge $((${h:-1} * 2)) ]; then dir=right; fi
  fi
  herdr_call pane split "$SELF_PANE" --direction "$dir" --cwd "$cwd" --no-focus || die "分出新 pane 失败：$HERR_MSG"
  local pane
  pane=$(jq -r '.result.pane.pane_id' <<<"$HOUT")

  local base try n started="" ready=1
  base=${name:-$(slug "$SELF_ADDR-$kind")}
  for n in "" 2 3 4 5 6 7 8 9; do
    try=$base${n:+-$n}
    if herdr_call agent start "$try" --kind "$kind" --pane "$pane" ${extra[@]+-- "${extra[@]}"}; then
      started=$try
      break
    fi
    case "$HERR_CODE" in
      agent_not_ready) started=$try ready=0; break ;;
      agent_name_taken) [ -z "$name" ] || break ;;
      *) break ;;
    esac
  done
  if [ -z "$started" ]; then
    local why=$HERR_MSG
    herdr_call pane close "$pane" || true
    die "启动 $kind 失败：${why:-未知错误}"
  fi

  local args=(--token "name=$started" --token "parent=$SELF_PANE")
  [ -n "$short" ] && args+=(--token "short=$short")
  [ -n "$role" ] && args+=(--token "role=$role")
  herdr_call pane report-metadata "$pane" --source "$SOURCE" "${args[@]}" || true

  if [ "$ready" = 1 ]; then
    printf '已启动子 agent %s（%s，pane %s，cwd %s）。用 patmat ask %s 交代任务；验收后 patmat dismiss %s。\n' \
      "$started" "$kind" "$pane" "$(tilde "$cwd")" "$started" "$started"
  else
    printf '子 agent %s（%s，pane %s）已启动，但停在确认界面（例如是否信任该目录）。请用户到那个 pane 处理，就绪后再 patmat ask %s。\n' \
      "$started" "$kind" "$pane" "$started"
  fi
}

cmd_dismiss() {
  need_herdr
  [ $# -ge 1 ] || die "用法：patmat dismiss <名字> [--force]"
  local force=0
  [ "${2:-}" = --force ] && force=1
  load_self
  resolve "$1"
  local parent pane status
  parent=$(jq -r '.result.agent.tokens.parent // empty' <<<"$TGT_JSON")
  pane=$(jq -r '.result.agent.pane_id' <<<"$TGT_JSON")
  status=$(jq -r '.result.agent.agent_status' <<<"$TGT_JSON")
  [ "$parent" = "$SELF_PANE" ] || die "$1 不是你启动的子 agent，只有启动它的 agent 或用户可以关闭它。"
  if [ "$status" = working ] && [ "$force" = 0 ]; then
    die "$1 还在工作。等它停下再 dismiss，或确认要中止时加 --force。"
  fi
  herdr_call pane close "$pane" || die "关闭 $1 失败：$HERR_MSG"
  printf '已关闭子 agent %s（pane %s）。\n' "$1" "$pane"
}

# 已适配的 CLI，每行：命令|herdr 集成 id|全局 skill 目录|全局指令文件
known_clis() {
  printf '%s\n' \
    "claude|claude|$HOME/.claude/skills|$HOME/.claude/CLAUDE.md" \
    "codex|codex|$HOME/.agents/skills|$HOME/.codex/AGENTS.md" \
    "grok|grok|$HOME/.grok/skills|$HOME/.grok/AGENTS.md"
}

# 名片指针：写进各 CLI 全局指令文件的那一节。
pointer_text() {
  cat <<'EOF'
## pat&mat

在 herdr 里工作时（环境变量 HERDR_ENV=1），接到任务先运行 `patmat card --short "<两到六个字的短名，让用户一眼认出这个会话>" --role "<你负责什么>" --doing "<正在做什么>"` 挂出名片，换任务时更新 --doing。要与其他 agent 协作，或收到以 [pat&mat 开头的消息时，使用 pat-mat skill；没有该 skill 时运行 `patmat help`。
EOF
}

# 本脚本的真实路径（穿过软链）。
script_path() {
  local src=$0 dir
  while [ -L "$src" ]; do
    dir=$(cd "$(dirname "$src")" && pwd -P)
    src=$(readlink "$src")
    case "$src" in /*) ;; *) src=$dir/$src ;; esac
  done
  printf '%s/%s' "$(cd "$(dirname "$src")" && pwd -P)" "$(basename "$src")"
}

# ensure_link <指向> <链接路径>：已正确就跳过；路径被别的东西占着就不动它。
ensure_link() {
  local target=$1 path=$2 cur
  if [ -L "$path" ]; then
    cur=$(readlink "$path")
    if [ "$cur" = "$target" ]; then
      printf '  已就绪  %s\n' "$path"
    else
      printf '  跳过    %s 已指向 %s，未改动\n' "$path" "$cur"
    fi
  elif [ -e "$path" ]; then
    printf '  跳过    %s 已存在且不是软链，未改动\n' "$path"
  else
    mkdir -p "$(dirname "$path")"
    ln -s "$target" "$path"
    printf '  已链接  %s -> %s\n' "$path" "$target"
  fi
}

cmd_install() {
  command -v herdr >/dev/null 2>&1 || die "找不到 herdr，请先安装：https://herdr.dev"
  command -v jq >/dev/null 2>&1 || die "找不到 jq，请先安装（brew install jq）"
  local self root
  self=$(script_path)
  root=$(dirname "$(dirname "$self")")
  [ -f "$root/SKILL.md" ] || die "在 $root 下找不到 SKILL.md，请从完整的 pat-mat 仓库里运行。"

  printf 'patmat 命令：\n'
  ensure_link "$self" "$HOME/.local/bin/patmat"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) printf '  注意    ~/.local/bin 不在 PATH 上，请把它加进你的 shell 配置\n' ;;
  esac

  local status bin id skills file line found=0
  status=$(herdr integration status 2>/dev/null || true)
  while IFS='|' read -r bin id skills file; do
    command -v "$bin" >/dev/null 2>&1 || continue
    found=1
    printf '%s：\n' "$bin"
    ensure_link "$root" "$skills/pat-mat"
    if [ -f "$file" ] && grep -q 'patmat card' "$file"; then
      printf '  已就绪  %s 里有名片指针\n' "$file"
    else
      mkdir -p "$(dirname "$file")"
      {
        if [ -s "$file" ]; then printf '\n'; fi
        pointer_text
      } >>"$file"
      printf '  已写入  名片指针 -> %s\n' "$file"
    fi
    line=$(printf '%s\n' "$status" | grep "^$id[ :(]" | head -1 || true)
    case "$line" in
      *": current"*) printf '  已就绪  herdr 集成 %s\n' "$id" ;;
      *)
        if herdr integration install "$id" </dev/null >/dev/null 2>&1; then
          printf '  已安装  herdr 集成 %s\n' "$id"
        else
          printf '  未完成  herdr 集成 %s，请手动运行 herdr integration install %s\n' "$id" "$id"
        fi
        ;;
    esac
  done <<EOF
$(known_clis)
EOF
  [ "$found" = 1 ] || printf '没有发现已适配的 CLI（claude、codex、grok）。装好其中一家后重跑 patmat install。\n'

  printf 'herdr 侧边栏：\n'
  local cfg=${HERDR_CONFIG_PATH:-$HOME/.config/herdr/config.toml}
  if [ -f "$cfg" ] && grep -q '\$short' "$cfg" && grep -q '\$role' "$cfg" && grep -q '\$doing' "$cfg"; then
    printf '  已就绪  %s\n' "$cfg"
  elif [ -f "$cfg" ] && grep -q '^\[ui\.sidebar\.agents\]' "$cfg"; then
    printf '  未完成  %s 里已有自定义的 [ui.sidebar.agents]，请手动把 %s 加进 rows\n' "$cfg" "\$short、\$role、\$doing"
  else
    mkdir -p "$(dirname "$cfg")"
    {
      if [ -s "$cfg" ]; then printf '\n'; fi
      cat <<'EOF'
[ui.sidebar.agents]
rows = [
  ["state_icon", "machine", "workspace", "tab"],
  ["$short", "agent", "$role"],
  ["$doing"],
]
EOF
    } >>"$cfg"
    printf '  已写入  名片行 -> %s\n' "$cfg"
    herdr server reload-config >/dev/null 2>&1 || printf '  注意    herdr 没在运行，侧边栏配置下次启动时生效\n'
  fi

  printf '\n装好了。在 herdr 里启动或重启 agent，它会自动挂出名片；随时可在 agent 里运行 patmat doctor 体检。\n'
  printf 'Codex 若使用 workspace-write 沙箱，还需放行 herdr socket，见 %s/SETUP.md。\n' "$root"
}

cmd_doctor() {
  local bad=0
  ok() { printf '  ok  %s\n' "$*"; }
  miss() {
    printf '  缺  %s\n' "$*"
    bad=1
  }
  note() { printf '  --  %s\n' "$*"; }

  if command -v herdr >/dev/null 2>&1; then ok "herdr：$(herdr --version 2>/dev/null)"; else miss "herdr 未安装（https://herdr.dev）"; fi
  if command -v jq >/dev/null 2>&1; then ok "jq"; else miss "jq 未安装"; fi

  local self onpath
  self=$(script_path)
  onpath=$(command -v patmat 2>/dev/null || true)
  if [ -n "$onpath" ]; then ok "patmat 在 PATH 上：$onpath"; else miss "patmat 不在 PATH 上：运行 \"$self\" install"; fi

  if [ "${HERDR_ENV:-}" = 1 ]; then
    ok "运行在 herdr 内"
    if command -v herdr >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
      if herdr_call agent list; then
        ok "herdr socket 可达，在线 agent $(jq '.result.agents | length' <<<"$HOUT") 个"
        load_self soft
        if [ -z "$SELF_PANE" ]; then
          miss "认不出本 Codex 会话在哪个 pane（多个 Codex 会话同时在工作），过几秒重跑"
        elif [ "$SELF_PANE" != "${HERDR_PANE_ID:-}" ]; then
          ok "本会话是 ${SELF_ADDR}，在 pane ${SELF_PANE}（按 Codex 线程 id 认出；继承来的 HERDR_PANE_ID=${HERDR_PANE_ID:-} 属于另一个 Codex 会话）"
        else
          ok "本会话是 ${SELF_ADDR}，在 pane $SELF_PANE"
        fi
      else
        miss "herdr socket 不可达：${HERR_MSG}。若出现 Operation not permitted，说明本 CLI 的沙箱拦住了 socket，见 SETUP.md 的沙箱一节"
      fi
    fi
  else
    miss "当前不在 herdr pane 内：先运行 herdr，再在里面启动 agent"
  fi

  local cfg=${HERDR_CONFIG_PATH:-$HOME/.config/herdr/config.toml}
  if [ -f "$cfg" ] && grep -q '\$short' "$cfg" && grep -q '\$role' "$cfg" && grep -q '\$doing' "$cfg"; then
    ok "侧边栏已配置显示 \$short / \$role / \$doing（${cfg}）"
  else
    miss "侧边栏还没显示名片：在 $cfg 的 [ui.sidebar.agents] rows 里加入 \$short、\$role、\$doing"
  fi

  if command -v herdr >/dev/null 2>&1; then
    local status bin id line
    status=$(herdr integration status 2>/dev/null || true)
    for bin in claude codex kimi grok agy; do
      command -v "$bin" >/dev/null 2>&1 || continue
      id=$bin
      [ "$bin" = agy ] && id=antigravity-cli
      line=$(printf '%s\n' "$status" | grep "^$id[ :(]" | head -1 || true)
      case "$line" in
        *": current"*) ok "herdr 集成 $id" ;;
        *) miss "herdr 集成 $id 未就绪：herdr integration install $id" ;;
      esac
    done
  fi

  # 每家已适配的 CLI：skill 可读，全局指令里有名片指针。
  local bin id skills file
  while IFS='|' read -r bin id skills file; do
    command -v "$bin" >/dev/null 2>&1 || continue
    if [ -r "$skills/pat-mat/SKILL.md" ]; then ok "$bin 能读到 skill（$skills/pat-mat）"; else miss "$bin 读不到 skill：运行 patmat install"; fi
    if [ -f "$file" ] && grep -q 'patmat card' "$file"; then ok "$bin 的全局指令里有名片指针（${file}）"; else miss "$bin 的全局指令缺名片指针：运行 patmat install"; fi
  done <<EOF
$(known_clis)
EOF
  for bin in kimi agy; do
    command -v "$bin" >/dev/null 2>&1 && note "${bin}：skill 目录和全局指令文件的位置请对照其文档，确认两处都已就位"
  done

  if [ "$bad" = 0 ]; then
    printf '全部就绪。\n'
  else
    printf '还有缺项，按 SETUP.md 逐项补齐后重跑 patmat doctor。\n'
    return 1
  fi
}

main() {
  local cmd=${1:-help}
  [ $# -gt 0 ] && shift
  case "$cmd" in
    who) cmd_who "$@" ;;
    card) cmd_card "$@" ;;
    ask) cmd_ask "$@" ;;
    reply) cmd_reply "$@" ;;
    tell) cmd_tell "$@" ;;
    spawn) cmd_spawn "$@" ;;
    dismiss) cmd_dismiss "$@" ;;
    install) cmd_install "$@" ;;
    pointer) pointer_text ;;
    doctor) cmd_doctor "$@" ;;
    help | -h | --help) usage ;;
    *) die "不认识的子命令 ${cmd}。运行 patmat help 查看用法。" ;;
  esac
}

main "$@"
